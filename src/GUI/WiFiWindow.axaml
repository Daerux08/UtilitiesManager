<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UtilitiesManager"
        xmlns:vm="clr-namespace:UtilitiesManager.ViewModels"
        xmlns:vc="clr-namespace:UtilitiesManager.ViewModels.Converters"
        Width="810" Height="400"
        x:Class="UtilitiesManager.WiFiWindow"
        x:DataType="vm:WiFiWindowViewModel"
        Title="Wi-Fi Networks"
        WindowStartupLocation="CenterScreen"
        Icon="avares://UtilitiesManager/Assets/UtilManagerV3.png">

    <Window.Resources>
        <vc:BoolToStatusConverter x:Key="BoolToStatusConverter" />
    </Window.Resources>

    <Window.Styles>
        <!-- Material Card Style -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BoxShadow" Value="0 1 4 0 rgba(0,0,0,0.08)"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
        
        <Style Selector="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="DataGrid">
            <Setter Property="Margin" Value="8"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal,Vertical"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="DataGridCell">
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1976D2"/>
        </Style>
    </Window.Styles>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <Border Grid.Row="0" Classes="card">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <TextBlock Text="📶" FontSize="16"/>
                <TextBlock Text="Wi-Fi Networks" 
                           FontSize="16" 
                           FontWeight="Bold" 
                           Foreground="#1976D2"/>
            </StackPanel>
        </Border>

        <!-- Data Grid -->
        <Border Grid.Row="1" Classes="card">
            <DataGrid Name="WiFiDataGrid"
                      ItemsSource="{Binding WiFiNetworks}"
                      SelectedItem="{Binding SelectedNetwork}"
                      DoubleTapped="WiFiDataGrid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="SSID" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding SSID}" 
                                        Width="200"/>
                    <DataGridTextColumn Header="Mode" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding Mode}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Channel" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding Chan}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="Rate" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding Rate}" 
                                        Width="100"/>
                    <DataGridTextColumn Header="Signal" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding Signal}" 
                                        Width="80"/>
                    <DataGridTextColumn Header="Security" 
                                        x:DataType="local:WiFiInfo"
                                        Binding="{Binding Security}" 
                                        Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Status and Buttons -->
        <StackPanel Grid.Row="2" Spacing="8" Margin="0,8,0,0">
            <!-- Status Label -->
            <TextBlock Text="{Binding StatusText}" 
                       HorizontalAlignment="Center" 
                       FontSize="12"
                       Foreground="#666666"/>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Spacing="8">
                <Button Content="Refresh" 
                        Command="{Binding RefreshCommand}"/>
                <Button Content="Close" 
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
