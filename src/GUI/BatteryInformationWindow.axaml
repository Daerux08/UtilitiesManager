<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UtilitiesManager.ViewModels"
        x:Class="UtilitiesManager.BatteryInformationWindow"
        x:DataType="vm:BatteryInformationViewModel"
        Title="Battery Information"
        Width="420" Height="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Battery Information"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentColor}" />

        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,4,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Model:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Model}" />

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="Black" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vendor:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Vendor}" />

                    <Border Grid.Row="3" Grid.ColumnSpan="2" Height="1" Background="Black" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Charge:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PercentageText}" FontSize="16" FontWeight="Bold" />

                    <Border Grid.Row="5" Grid.ColumnSpan="2" Height="1" Background="Black" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="State:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StateText}" />

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Time:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding TimeText}" />

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Power:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding PowerText}" />

                    <Border Grid.Row="9" Grid.ColumnSpan="2" Height="1" Background="Black" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Profile:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedProfile}" />

                    <Border Grid.Row="11" Grid.ColumnSpan="2" Height="1" Background="Black" Margin="0,6,0,6" />

                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Health:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding CapacityText}" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
            <Button Classes="clickable-label" Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
