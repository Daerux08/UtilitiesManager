<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UtilitiesManager"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="320"
        x:Class="UtilitiesManager.MainWindow"
        x:DataType="local:MainWindow"
        Title="UtilitiesManager"
        WindowStartupLocation="CenterScreen"
        Icon="avares://UtilitiesManager/Assets/UtilManagerV3.png">
    <Window.Resources>
        <local:BoolToStringConverter x:Key="BoolToStringConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Margin" Value="0,5,0,1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Slider">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>


        <!--   Clickable-label-style buttons          -->
        <Style Selector="Button.clickable-label">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="4,6,4,6"/>           
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>               
        </Style>

        <!-- Hover underline-->
        <Style Selector="Button.clickable-label:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="TextBlock.Foreground" Value="#0066CC"/>
            <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
        </Style>

        <!-- Disabled state -->
        <Style Selector="Button.clickable-label:disabled">
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="25,35,25,25"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                MaxWidth="420">
        <TextBlock Text="Utility Manager v0.0 – "
                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Slider 1 – Sound Level"/>
        <Slider Minimum="0" Maximum="100"
                Value="{Binding SoundLevel}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                IsEnabled="{Binding SoundAvailable}">
            <ToolTip.Tip>
                <TextBlock Text="{Binding SoundAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='pactl is not found|Volume control'}" />
            </ToolTip.Tip>
        </Slider>
        <TextBox Text="{Binding SoundLevelText}"
                 HorizontalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="#000000"
                 Width="60"
                 TextAlignment="Center"/>
        <TextBlock Text="Slider 2 – Screen Brightness"/>
        <Slider Minimum="0" Maximum="100"
                Value="{Binding Brightness}"
                TickFrequency="1" IsSnapToTickEnabled="True"
                IsEnabled="{Binding BrightnessAvailable}">
            <ToolTip.Tip>
                <TextBlock Text="{Binding BrightnessAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='brightnessctl is not found|Brightness control'}" />
            </ToolTip.Tip>
        </Slider>
        <TextBox Text="{Binding BrightnessText}"
                 HorizontalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="#000000"
                 Width="60"
                 TextAlignment="Center"/>

                    <!-- Wi-Fi-->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0">
            <Button Classes="clickable-label"
                    Content="Open Wi-Fi Menu"
                    Click="OpenWiFi_Click"
                    IsEnabled="{Binding WiFiAvailable}">
                <ToolTip.Tip>
                    <TextBlock Text="{Binding WiFiAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='nmcli is not found|Wi-Fi networks'}" />
                </ToolTip.Tip>
            </Button>

            <Button Classes="clickable-label"
                    Content="Open Battery Menu"
                    Click="OpenBattery_Click"
                    IsEnabled="{Binding BatteryAvailable}">
                <ToolTip.Tip>
                    <TextBlock Text="{Binding BatteryAvailable, Converter={StaticResource BoolToStringConverter}, ConverterParameter='upower is not found|Battery status'}" />
                </ToolTip.Tip>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>