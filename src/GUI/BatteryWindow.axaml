<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UtilitiesManager.ViewModels"
        x:Class="UtilitiesManager.BatteryWindow"
        x:DataType="vm:BatteryWindowViewModel"
        Title="Battery Status"
        Width="360" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Battery Status"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentColor}" />

        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,4,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Charge:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentageText}" FontSize="16" FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="State:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StateText}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Time:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimeText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Power:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerText}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Profile:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentProfile}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="Power Profiles"
                   FontSize="14"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button Content="Power Saver"
                    Width="100"
                    Height="36"
                    Command="{Binding SetPowerSaverCommand}"
                    ToolTip.Tip="Minimizes power consumption by reducing performance. Best for extending battery life." />
            <Button Content="Balanced"
                    Width="100"
                    Height="36"
                    Command="{Binding SetBalancedCommand}"
                    ToolTip.Tip="Balances performance and power consumption. Good for everyday use." />
            <Button Content="Performance"
                    Width="90"
                    Height="36"
                    Command="{Binding SetPerformanceCommand}"
                    ToolTip.Tip="Maximizes performance at the cost of higher power consumption. Best for demanding tasks." />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8,0,0">
            <Button Content="Refresh"
                    Width="100"
                    Command="{Binding RefreshCommand}" />
            <Button Content="Close"
                    Width="100"
                    Command="{Binding CloseCommand}" />
        </StackPanel>
    </StackPanel>
</Window>