<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UtilitiesManager.ViewModels"
        x:Class="UtilitiesManager.BatteryWindow"
        x:DataType="vm:BatteryWindowViewModel"
        Title="Battery Status"
        Width="360" Height="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="Battery Status"
                   FontSize="18"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource AccentColor}" />

        <Border BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,4,0,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Charge:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentageText}" FontSize="16" FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="State:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StateText}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Time:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TimeText}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Power:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PowerText}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Profile:" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CurrentProfile}" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Text="Power Profiles"
               FontSize="14"
               FontWeight="SemiBold"
               HorizontalAlignment="Center"
               Margin="0,4,0,8" />

        <ComboBox ItemsSource="{Binding AvailableProfiles}"
              SelectedItem="{Binding SelectedProfile}"
              IsEnabled="{Binding PowerProfilesAvailable}"
              Width="240"
              HorizontalAlignment="Center"
              Margin="0,4,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,8,0,0">
        <Button Classes="clickable-label" Content="Refresh"
            Command="{Binding RefreshCommand}" />
        <Button Classes="clickable-label" Content="Battery information"
            Click="OpenBatteryInformation" />
        </StackPanel>
    </StackPanel>
</Window>