<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="UtilitiesManager.EnterPasswordPopup"
        Title="Enter WiFi Password"
        Width="400"
        Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Icon="avares://UtilitiesManager/Assets/UtilManagerV3.png">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Margin" Value="10,5"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Margin" Value="10,5"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="20" Spacing="10">
        <!-- Label with SSID -->
        <TextBlock Name="SSIDLabel" 
                   FontSize="14"
                   TextWrapping="Wrap"/>

        <!-- Password TextBox -->
        <TextBox Name="PasswordTextBox"
                 PasswordChar="*"
                 Watermark="Enter password"
                 KeyDown="PasswordTextBox_KeyDown"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Spacing="10"
                    Margin="0,10,0,0">
            <Button Name="ConnectButton"
                    Content="Connect" 
                    Click="ConnectButton_Click"/>
            <Button Content="Cancel" 
                    Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
